# ComfyUI server URL
COMFYUI_URL=http://127.0.0.1:8188

# ComfyUI root directory (contains input/ and output/)
# Defaults to the parent directory of h3_studio
COMFYUI_BASE_DIR=/path/to/comfyui-h3

# Optional overrides for input/output directories
# COMFYUI_INPUT_DIR=/path/to/comfyui-h3/input
# COMFYUI_OUTPUT_DIR=/path/to/comfyui-h3/output

# Directory where Markdown storyboard scripts (*.md) are stored
# Defaults to ./scripts inside h3_studio
H3_SCRIPTS_DIR=/path/to/scripts

# Optional default Tailscale target device name for mobile sharing
H3_TAILSCALE_TARGET=

# Web UI bind host and port
H3_STUDIO_HOST=127.0.0.1
H3_STUDIO_PORT=7860
